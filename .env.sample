# General Application Settings
VITE_APP_TITLE="Your Frontend Demo" # The title of the application, displayed in the browser tab or header
VITE_APP_ENV="development" # The application environment (e.g., development, production, staging)
VITE_PORT="3000" # The port on which the development server will run

# Backend API Endpoints
VITE_API_BASE_URL="http://localhost:8080/api/v1" # The base URL for the primary backend API (e.g., for products)
VITE_AUTH_API_URL="http://localhost:8080/api/auth" # The base URL for the authentication-related API endpoints

# Authentication Configuration
VITE_AUTH_CLIENT_ID="your_auth_client_id_here" # The client ID for OAuth/OIDC authentication flows
VITE_AUTH_REDIRECT_URI="http://localhost:3000/auth/callback" # The redirect URI after successful authentication

# Third-Party Integrations
VITE_ANALYTICS_ID="UA-XXXXX-Y" # Tracking ID for your analytics service (e.g., Google Analytics)
VITE_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0" # DSN for Sentry error tracking
